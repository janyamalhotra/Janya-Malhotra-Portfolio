	<script id="hero-name-ascii-script">
(function() {
  'use strict';

  // --- SCREEN 1 ONLY MUTE BUTTON CONTROLLER ---
  function updateSoundButtonOnScroll() {
    var soundBtn = document.querySelector('.sound-toggle');
    if (!soundBtn) return;
    var maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
    var t = Math.max(0, Math.min(1, window.scrollY / maxScroll));
    if (t <= 0.08) {
      soundBtn.style.opacity = '1';
      soundBtn.style.visibility = 'visible';
      soundBtn.style.pointerEvents = 'auto';
    } else if (t < 0.14) {
      var fade = Math.max(0, Math.min(1, (0.14 - t) / 0.06));
      soundBtn.style.opacity = String(fade);
      soundBtn.style.visibility = 'visible';
      soundBtn.style.pointerEvents = fade > 0.1 ? 'auto' : 'none';
    } else {
      soundBtn.style.opacity = '0';
      soundBtn.style.visibility = 'hidden';
      soundBtn.style.pointerEvents = 'none';
    }
  }
  window.addEventListener('scroll', updateSoundButtonOnScroll, { passive: true });
  updateSoundButtonOnScroll();

  // Initial sound toggle click fallback
  function setupSoundToggleFallback() {
    var soundBtn = document.querySelector('.sound-toggle');
    if (!soundBtn || soundBtn.__fallbackBound) return;
    soundBtn.__fallbackBound = true;
    soundBtn.addEventListener('click', function() {
      var isMuted = soundBtn.classList.contains('is-muted');
      if (isMuted) {
        soundBtn.classList.remove('is-muted');
        soundBtn.classList.add('is-unmuted');
        soundBtn.setAttribute('aria-label', 'Mute sound');
        soundBtn.setAttribute('title', 'Mute sound');
        try { sessionStorage.setItem('portfolio_sound', 'true'); } catch(e){}
        var path = soundBtn.querySelector('path');
        if (path) path.setAttribute('d', 'M11 5L6 9H2v6h4l5 4V5zM15.5 8.5a5 5 0 0 1 0 7M19 5a9.5 9.5 0 0 1 0 14');
      } else {
        soundBtn.classList.remove('is-unmuted');
        soundBtn.classList.add('is-muted');
        soundBtn.setAttribute('aria-label', 'Unmute sound');
        soundBtn.setAttribute('title', 'Unmute sound');
        try { sessionStorage.setItem('portfolio_sound', 'false'); } catch(e){}
        var path = soundBtn.querySelector('path');
        if (path) path.setAttribute('d', 'M11 5L6 9H2v6h4l5 4V5zM22 9l-6 6M16 9l6 6');
      }
    });
  }
  setupSoundToggleFallback();

  // --- BULLETPROOF TEXT-CONTOUR ASCII TYPOGRAPHY ENGINE ---
  if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    return;
  }

  function initHeroAscii() {
    var heroName = document.querySelector('.hero-name');
    if (!heroName) return;

    var canvas = heroName.querySelector('.hero-name-ascii-canvas');
    if (!canvas) {
      canvas = document.createElement('canvas');
      canvas.className = 'hero-name-ascii-canvas';
      canvas.setAttribute('aria-hidden', 'true');
      heroName.appendChild(canvas);
    }

    var ctx = canvas.getContext('2d');
    if (!ctx) return;

    var width = 0, height = 0, dpr = 1;
    var nodes = [];
    var isNear = false;
    var targetAlpha = 0, currentAlpha = 0;
    var targetX = -999, targetY = -999;
    var currentX = -999, currentY = -999;
    var currentRadius = 0, maxRadius = 120;
    var rafId = null;
    var touchActive = false;
    var touchTimer = null;

    var PALETTE = ['#FFF4D0', '#F5CB5C', '#E09F3E', '#B26E23', '#7F4810'];
    var contourChars = ['0', '1', '/', '\\', '|', '+', ':', '.'];

    function rebuildNodes() {
      if (!heroName.isConnected) return;
      var rect = heroName.getBoundingClientRect();
      var w = Math.round(rect.width);
      var h = Math.round(rect.height);
      if (w <= 0 || h <= 0) return;

      width = w;
      height = h;
      dpr = Math.min(window.devicePixelRatio || 1, 2);

      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      canvas.style.width = w + 'px';
      canvas.style.height = h + 'px';

      maxRadius = Math.max(90, Math.min(140, Math.round(h * 0.92)));

      var spans = heroName.querySelectorAll('.hero-name-text > span');
      if (!spans || spans.length === 0) return;

      var offCanvas = document.createElement('canvas');
      offCanvas.width = Math.round(w * dpr);
      offCanvas.height = Math.round(h * dpr);
      var offCtx = offCanvas.getContext('2d', { willReadFrequently: true });
      if (!offCtx) return;

      offCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
      offCtx.clearRect(0, 0, w, h);
      offCtx.fillStyle = '#ffffff';
      offCtx.textBaseline = 'alphabetic';
      offCtx.textAlign = 'left';

      var firstComp = window.getComputedStyle(spans[0]);
      var fontStyle = firstComp.fontStyle || 'italic';
      var fontWeight = firstComp.fontWeight || '400';
      var fontSizeStr = firstComp.fontSize || '72px';
      var fontFamily = firstComp.fontFamily || "'Cormorant Garamond', Georgia, serif";
      var fontSizeNum = parseFloat(fontSizeStr) || 72;

      spans.forEach(function(span) {
        var probe = document.createElement('span');
        probe.style.cssText = 'display:inline-block;vertical-align:baseline;width:0;height:0;padding:0;margin:0;border:0;';
        span.appendChild(probe);
        var probeRect = probe.getBoundingClientRect();
        var spanRect = span.getBoundingClientRect();
        span.removeChild(probe);

        var baselineY = probeRect.top ? (probeRect.top - rect.top) : (spanRect.top - rect.top + fontSizeNum * 0.75);
        var startX = spanRect.left - rect.left;

        var sComp = window.getComputedStyle(span);
        offCtx.font = (sComp.fontStyle || fontStyle) + ' ' + (sComp.fontWeight || fontWeight) + ' ' + (sComp.fontSize || fontSizeStr) + ' ' + (sComp.fontFamily || fontFamily);
        offCtx.fillText(span.textContent.trim(), startX, baselineY);
      });

      var imgData = offCtx.getImageData(0, 0, Math.round(w * dpr), Math.round(h * dpr));
      var data = imgData.data;
      var stride = Math.round(w * dpr);
      var newNodes = [];

      var stepX = Math.max(3.8, Math.min(5.4, fontSizeNum * 0.068));
      var stepY = Math.max(4.6, Math.min(6.4, fontSizeNum * 0.082));

      for (var y = 1; y < h - 1; y += stepY) {
        for (var x = 1; x < w - 1; x += stepX) {
          var px = Math.round(x * dpr);
          var py = Math.round(y * dpr);
          if (px >= stride || py >= Math.round(h * dpr)) continue;
          var idx = (py * stride + px) * 4;
          var alpha = data[idx + 3];

          if (alpha > 28) {
            var leftAlpha = data[(py * stride + Math.max(0, px - 2)) * 4 + 3] || 0;
            var rightAlpha = data[(py * stride + Math.min(stride - 1, px + 2)) * 4 + 3] || 0;
            var topAlpha = data[(Math.max(0, py - 2) * stride + px) * 4 + 3] || 0;
            var bottomAlpha = data[(Math.min(Math.round(h * dpr) - 1, py + 2) * stride + px) * 4 + 3] || 0;
            var isEdge = (leftAlpha < 45 || rightAlpha < 45 || topAlpha < 45 || bottomAlpha < 45);

            var char = !isEdge ? (Math.random() < 0.5 ? '0' : '1') : contourChars[Math.floor(Math.random() * contourChars.length)];
            var colorIdx = (alpha > 210 && !isEdge) ? 0 : ((alpha > 150 && !isEdge) ? 1 : (alpha > 90 ? 2 : (alpha > 50 ? 3 : 4)));
            var jx = (Math.random() - 0.5) * 1.2;
            var jy = (Math.random() - 0.5) * 1.2;

            newNodes.push({
              x: x + jx,
              y: y + jy,
              baseChar: char,
              char: char,
              colorIdx: colorIdx,
              baseAlpha: Math.min(1.0, (alpha / 255) * (0.88 + Math.random() * 0.2)),
              seed: Math.random() * 62.8,
              shimmerSpeed: 0.002 + Math.random() * 0.003
            });
          }
        }
      }
      nodes = newNodes;
    }

    function render(time) {
      currentAlpha += (targetAlpha - currentAlpha) * 0.12;

      if (currentAlpha < 0.005) {
        currentAlpha = 0;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, width, height);
        heroName.classList.remove('has-ascii-hover');
        heroName.style.removeProperty('--ascii-mask-x');
        heroName.style.removeProperty('--ascii-mask-y');
        heroName.style.removeProperty('--ascii-mask-r');
        rafId = null;
        return;
      }

      currentX += (targetX - currentX) * 0.16;
      currentY += (targetY - currentY) * 0.16;
      currentRadius = maxRadius * currentAlpha;

      heroName.classList.add('has-ascii-hover');
      heroName.style.setProperty('--ascii-mask-x', currentX.toFixed(1) + 'px');
      heroName.style.setProperty('--ascii-mask-y', currentY.toFixed(1) + 'px');
      heroName.style.setProperty('--ascii-mask-r', currentRadius.toFixed(1) + 'px');

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, width, height);

      var t = currentRadius * currentRadius;
      var innerR = currentRadius * 0.40;
      var innerR2 = innerR * innerR;

      var charFontSize = Math.max(6.5, Math.min(9, Math.round(width * 0.024))) || 7.5;
      ctx.font = charFontSize + 'px Consolas, Courier New, monospace';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';

      for (var i = 0; i < nodes.length; i++) {
        var node = nodes[i];
        var dx = node.x - currentX;
        var dy = node.y - currentY;
        var dist2 = dx * dx + dy * dy;

        if (dist2 < t) {
          var feather = 1;
          if (dist2 > innerR2) {
            var dist = Math.sqrt(dist2);
            feather = 1 - (dist - innerR) / (currentRadius - innerR);
            if (feather < 0) feather = 0;
            feather = feather * feather * (3 - 2 * feather);
          }

          var nodeFinalAlpha = feather * node.baseAlpha * currentAlpha;
          if (nodeFinalAlpha > 0.02) {
            var shimmerVal = Math.sin(time * node.shimmerSpeed + node.seed);
            var displayChar = node.char;
            var displayColor = PALETTE[node.colorIdx];

            if (shimmerVal > 0.94) {
              displayChar = node.baseChar === '0' ? '1' : (node.baseChar === '1' ? '0' : node.baseChar);
              displayColor = PALETTE[0];
            }

            ctx.globalAlpha = nodeFinalAlpha;
            ctx.fillStyle = displayColor;
            ctx.fillText(displayChar, node.x, node.y);
          }
        }
      }

      ctx.globalAlpha = 1.0;
      rafId = requestAnimationFrame(render);
    }

    function wakeAnimation() {
      if (!rafId) {
        rafId = requestAnimationFrame(render);
      }
    }

    function updatePointer(clientX, clientY) {
      if (!heroName.isConnected) return;
      var maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
      if ((window.scrollY / maxScroll) >= 0.14) {
        if (isNear) { isNear = false; targetAlpha = 0; }
        return;
      }

      var rect = heroName.getBoundingClientRect();
      var relX = clientX - rect.left;
      var relY = clientY - rect.top;
      var buffer = 65;

      var inProximity = (
        relX >= -buffer &&
        relX <= rect.width + buffer &&
        relY >= -buffer &&
        relY <= rect.height + buffer
      );

      if (inProximity) {
        isNear = true;
        targetX = Math.max(0, Math.min(rect.width, relX));
        targetY = Math.max(0, Math.min(rect.height, relY));

        if (currentAlpha < 0.05) {
          currentX = targetX;
          currentY = targetY;
        }
        targetAlpha = 1.0;
        wakeAnimation();
      } else {
        if (isNear) {
          isNear = false;
          targetAlpha = 0;
        }
      }
    }

    window.addEventListener('pointermove', function(e) {
      if (touchActive) return;
      updatePointer(e.clientX, e.clientY);
    }, { passive: true });

    heroName.addEventListener('touchstart', function(e) {
      if (e.touches && e.touches.length > 0) {
        var maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        if ((window.scrollY / maxScroll) >= 0.14) return;

        touchActive = true;
        var touch = e.touches[0];
        var rect = heroName.getBoundingClientRect();
        targetX = touch.clientX - rect.left;
        targetY = touch.clientY - rect.top;
        currentX = targetX;
        currentY = targetY;
        targetAlpha = 1.0;
        wakeAnimation();

        if (touchTimer) clearTimeout(touchTimer);
        touchTimer = setTimeout(function() {
          targetAlpha = 0;
          setTimeout(function() { touchActive = false; }, 800);
        }, 2500);
      }
    }, { passive: true });

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(function() { rebuildNodes(); });
    }

    var resizeTimer = null;
    var ro = window.ResizeObserver ? new ResizeObserver(function() {
      if (resizeTimer) clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function() { rebuildNodes(); }, 80);
    }) : null;
    if (ro) ro.observe(heroName);

    rebuildNodes();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroAscii);
  } else {
    initHeroAscii();
  }
})();
</script>
<script id="project-stack-navigation-script">
(function() {
  function navigateToProject(idx) {
    var startProg = 0.15;
    var projRange = 0.82;
    var targetH = idx + 0.35;
    var targetProg = targetH / 5.9;
    var targetT = startProg + targetProg * projRange;
    var pRoot = document.querySelector('.portfolio-root');
    var maxScroll = pRoot ? (pRoot.offsetHeight - window.innerHeight) : (document.documentElement.scrollHeight - window.innerHeight);
    var pTop = pRoot ? (pRoot.getBoundingClientRect().top + window.scrollY) : 0;
    window.scrollTo({ top: Math.round(pTop + targetT * maxScroll), behavior: 'smooth' });
  }

  document.addEventListener('click', function(e) {
    var dot = e.target.closest('.progress-dot');
    if (dot) {
      var idx = parseInt(dot.getAttribute('data-index'), 10);
      if (!isNaN(idx)) {
        navigateToProject(idx);
      }
      return;
    }

    var stackedCard = e.target.closest('.portfolio-project-card.is-stacked');
    if (stackedCard) {
      var idx = parseInt(stackedCard.getAttribute('data-index'), 10);
      if (!isNaN(idx)) {
        navigateToProject(idx);
      }
      return;
    }

    var activeCard = e.target.closest('.portfolio-project-card.is-active');
    if (activeCard) {
      var href = activeCard.getAttribute('data-href');
      if (href) {
        window.location.href = href;
      }
    }
  });
})();
</script>

<script id="dandelion-footer-simulation-script">
(function() {
  function initDandelions() {
    var canvas = document.getElementById('dandelion-footer-canvas');
    if (!canvas) return;

    var ctx = canvas.getContext('2d');
    if (!ctx) return;

    var footer = canvas.closest('.homepage-grassland-footer') || canvas.parentElement;
    var prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var width = 0;
    var height = 0;
    var dpr = 1;
    var animId = null;
    var isVisible = false;
    var time = 0;

    function Dandelion(xRatio, heightRatio, radius, seedCount, phase) {
      this.xRatio = xRatio;
      this.heightRatio = heightRatio;
      this.radius = radius;
      this.seedCount = seedCount;
      this.phase = phase;
      this.dispersed = false;
      this.x = 0;
      this.y = 0;
      this.stemBaseX = 0;
      this.stemBaseY = 0;
      this.stemCurveX = 0;
      this.seeds = [];
    }

    Dandelion.prototype.init = function() {
      this.x = width * this.xRatio;
      this.y = height - height * this.heightRatio;
      this.stemBaseX = this.x - (this.xRatio - 0.5) * 40;
      this.stemBaseY = height + 10;
      this.stemCurveX = (this.stemBaseX + this.x) / 2 + Math.sin(this.phase) * 15;

      this.seeds = [];
      for (var i = 0; i < this.seedCount; i++) {
        var theta = (i / this.seedCount) * Math.PI * 2 + (i % 3) * 0.12;
        var rLen = this.radius * (0.75 + (i % 7) * 0.05);
        this.seeds.push({
          theta: theta,
          rLen: rLen,
          relX: Math.cos(theta) * rLen,
          relY: Math.sin(theta) * rLen,
          x: this.x + Math.cos(theta) * rLen,
          y: this.y + Math.sin(theta) * rLen,
          vx: 0,
          vy: 0,
          vAngle: 0,
          angle: theta,
          detached: false,
          opacity: 0.92 + (i % 5) * 0.015,
          seedLength: 10 + (i % 4) * 2,
          pappusRadius: 5 + (i % 3) * 1.5,
          color: (i % 6 === 0) ? '#FFD782' : '#FAF8F1',
          decay: 0.0012 + (i % 5) * 0.0003
        });
      }
    };

    Dandelion.prototype.disperse = function(cursorX, cursorY) {
      if (this.dispersed) return;
      this.dispersed = true;

      for (var i = 0; i < this.seeds.length; i++) {
        var seed = this.seeds[i];
        seed.detached = true;
        var angleFromCenter = Math.atan2(seed.y - this.y, seed.x - this.x);
        var angleFromCursor = (cursorX !== undefined) 
          ? Math.atan2(seed.y - cursorY, seed.x - cursorX)
          : angleFromCenter;
        
        var launchAngle = angleFromCursor * 0.6 + angleFromCenter * 0.4 + (Math.random() - 0.5) * 0.5;
        var launchSpeed = 0.8 + Math.random() * 2.8;

        seed.vx = Math.cos(launchAngle) * launchSpeed + 0.9 + Math.random() * 1.3;
        seed.vy = Math.sin(launchAngle) * launchSpeed - 1.2 - Math.random() * 2.2;
        seed.vAngle = (Math.random() - 0.5) * 0.08;
      }
    };

    Dandelion.prototype.update = function() {
      var sway = Math.sin(time * 0.0015 + this.phase) * 3;
      var currentHeadX = this.x + sway;

      for (var i = 0; i < this.seeds.length; i++) {
        var seed = this.seeds[i];
        if (!seed.detached) {
          seed.x = currentHeadX + seed.relX;
          seed.y = this.y + seed.relY;
        } else {
          seed.vx += 0.016;
          seed.vy += 0.018;
          seed.vx *= 0.988;
          seed.vy *= 0.988;
          seed.angle += seed.vAngle;
          seed.x += seed.vx;
          seed.y += seed.vy;
          seed.opacity -= seed.decay;
        }
      }
    };

    Dandelion.prototype.draw = function(ctx) {
      var sway = Math.sin(time * 0.0015 + this.phase) * 3;
      var currentHeadX = this.x + sway;

      // Stem
      ctx.beginPath();
      ctx.moveTo(this.stemBaseX, this.stemBaseY);
      ctx.quadraticCurveTo(this.stemCurveX + sway * 0.5, (this.stemBaseY + this.y) * 0.55, currentHeadX, this.y);
      ctx.strokeStyle = 'rgba(110, 145, 85, 0.75)';
      ctx.lineWidth = 2.4 * dpr;
      ctx.stroke();

      // Stem Highlight
      ctx.beginPath();
      ctx.moveTo(this.stemBaseX, this.stemBaseY);
      ctx.quadraticCurveTo(this.stemCurveX + sway * 0.5, (this.stemBaseY + this.y) * 0.55, currentHeadX, this.y);
      ctx.strokeStyle = 'rgba(216, 164, 70, 0.35)';
      ctx.lineWidth = 1 * dpr;
      ctx.stroke();

      // Receptacle Center
      ctx.beginPath();
      ctx.arc(currentHeadX, this.y, 4.5 * dpr, 0, Math.PI * 2);
      ctx.fillStyle = this.dispersed ? '#5F7A2A' : '#D8A446';
      ctx.fill();

      ctx.beginPath();
      ctx.arc(currentHeadX, this.y, 2.5 * dpr, 0, Math.PI * 2);
      ctx.fillStyle = '#FAF8F1';
      ctx.fill();

      // Seeds
      for (var i = 0; i < this.seeds.length; i++) {
        var seed = this.seeds[i];
        if (seed.opacity <= 0) continue;

        ctx.save();
        ctx.globalAlpha = Math.max(0, Math.min(1, seed.opacity));

        if (!seed.detached) {
          ctx.beginPath();
          ctx.moveTo(currentHeadX, this.y);
          ctx.lineTo(seed.x, seed.y);
          ctx.strokeStyle = 'rgba(250, 248, 241, 0.45)';
          ctx.lineWidth = 0.9 * dpr;
          ctx.stroke();

          ctx.beginPath();
          ctx.arc(seed.x, seed.y, 1.4 * dpr, 0, Math.PI * 2);
          ctx.fillStyle = seed.color;
          ctx.fill();

          var pr = 3.5 * dpr;
          for (var k = -1; k <= 1; k++) {
            var hAngle = seed.theta + (k * 0.5);
            ctx.beginPath();
            ctx.moveTo(seed.x, seed.y);
            ctx.lineTo(seed.x + Math.cos(hAngle) * pr, seed.y + Math.sin(hAngle) * pr);
            ctx.strokeStyle = 'rgba(250, 248, 241, 0.65)';
            ctx.lineWidth = 0.7 * dpr;
            ctx.stroke();
          }
        } else {
          ctx.translate(seed.x, seed.y);
          ctx.rotate(seed.angle);

          ctx.beginPath();
          ctx.moveTo(0, 0);
          ctx.lineTo(0, -seed.seedLength * dpr * 0.7);
          ctx.strokeStyle = 'rgba(250, 248, 241, 0.6)';
          ctx.lineWidth = 0.9 * dpr;
          ctx.stroke();

          ctx.beginPath();
          ctx.ellipse(0, 0, 1.2 * dpr, 2.2 * dpr, 0, 0, Math.PI * 2);
          ctx.fillStyle = '#8C8A3A';
          ctx.fill();

          var topY = -seed.seedLength * dpr * 0.7;
          ctx.beginPath();
          ctx.arc(0, topY, 1.5 * dpr, 0, Math.PI * 2);
          ctx.fillStyle = seed.color;
          ctx.fill();

          var bristleCount = 7;
          var brLen = seed.pappusRadius * dpr;
          for (var b = 0; b < bristleCount; b++) {
            var bAngle = -Math.PI / 2 + ((b / (bristleCount - 1)) - 0.5) * 1.8;
            ctx.beginPath();
            ctx.moveTo(0, topY);
            ctx.lineTo(Math.cos(bAngle) * brLen, topY + Math.sin(bAngle) * brLen);
            ctx.strokeStyle = 'rgba(255, 250, 240, 0.85)';
            ctx.lineWidth = 0.8 * dpr;
            ctx.stroke();
          }
        }
        ctx.restore();
      }
    };

    var dandelions = [
      new Dandelion(0.12, 0.36, 32, 54, 0.5),
      new Dandelion(0.26, 0.44, 36, 62, 1.8),
      new Dandelion(0.42, 0.30, 28, 48, 3.2),
      new Dandelion(0.60, 0.46, 38, 64, 4.5),
      new Dandelion(0.76, 0.34, 30, 52, 2.1),
      new Dandelion(0.90, 0.42, 34, 58, 5.7)
    ];

    function resize() {
      var rect = footer.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      dpr = Math.min(window.devicePixelRatio || 1, 2);

      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      canvas.style.width = width + 'px';
      canvas.style.height = height + 'px';

      for (var i = 0; i < dandelions.length; i++) {
        dandelions[i].init();
      }
    }

    function handleInteraction(clientX, clientY) {
      if (prefersReduced) return;
      var rect = canvas.getBoundingClientRect();
      var cursorX = (clientX - rect.left) * dpr;
      var cursorY = (clientY - rect.top) * dpr;
      var triggerRadius = 70 * dpr;

      for (var i = 0; i < dandelions.length; i++) {
        var d = dandelions[i];
        if (d.dispersed) continue;
        var dx = cursorX - d.x;
        var dy = cursorY - d.y;
        var dist = Math.hypot(dx, dy);

        if (dist < triggerRadius) {
          d.disperse(cursorX, cursorY);
        }
      }
    }

    footer.addEventListener('pointermove', function(e) {
      handleInteraction(e.clientX, e.clientY);
    }, { passive: true });

    footer.addEventListener('pointerdown', function(e) {
      handleInteraction(e.clientX, e.clientY);
    }, { passive: true });

    footer.addEventListener('touchstart', function(e) {
      if (e.touches && e.touches.length > 0) {
        handleInteraction(e.touches[0].clientX, e.touches[0].clientY);
      }
    }, { passive: true });

    function render(timestamp) {
      if (!isVisible) return;
      time = timestamp || 0;

      ctx.clearRect(0, 0, canvas.width, canvas.height);

      for (var i = 0; i < dandelions.length; i++) {
        dandelions[i].update();
        dandelions[i].draw(ctx);
      }

      animId = requestAnimationFrame(render);
    }

    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function(entries) {
        for (var i = 0; i < entries.length; i++) {
          if (entries[i].isIntersecting) {
            isVisible = true;
            if (!animId) animId = requestAnimationFrame(render);
          } else {
            isVisible = false;
            if (animId) {
              cancelAnimationFrame(animId);
              animId = null;
            }
          }
        }
      }, { threshold: 0.05 });

      observer.observe(footer);
    } else {
      isVisible = true;
      animId = requestAnimationFrame(render);
    }

    window.addEventListener('resize', resize, { passive: true });
    resize();

    // Smooth scroll for footer Projects link
    var projBtn = document.getElementById('footer-btn-projects');
    if (projBtn) {
      projBtn.addEventListener('click', function(e) {
        e.preventDefault();
        var pRoot = document.querySelector('.portfolio-root');
        if (pRoot) {
          var pTop = pRoot.getBoundingClientRect().top + window.scrollY;
          var pDist = pRoot.offsetHeight - window.innerHeight;
          // Scroll to project 1 (index 0) position
          var targetProg = 0.15 + (0.35 / 5.9) * 0.82;
          window.scrollTo({ top: Math.round(pTop + targetProg * pDist), behavior: 'smooth' });
        }
      });
    }

    // Dynamic year
    var yearEl = document.getElementById('footer-dynamic-year');
    if (yearEl) {
      yearEl.textContent = new Date().getFullYear();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDandelions);
  } else {
    initDandelions();
  }
})();
</script>

</body></html>